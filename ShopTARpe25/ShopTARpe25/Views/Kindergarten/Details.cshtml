@model ShopTARpe25.Models.Kindergarten.KindergartenDetailsViewModel

@{
    ViewData["Title"] = "Kindergarten Details";
}

<div class="container">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h2 class="my-4 fw-bold">Kindergarten Details</h2>

            <div class="card p-4 shadow-sm">
                <dl class="row">
                    <dt class="col-sm-4 fw-bold mb-3">Id</dt>
                    <dd class="col-sm-8 mb-3 text-muted">@Model.Id</dd>

                    <dt class="col-sm-4 fw-bold mb-3">Group Name</dt>
                    <dd class="col-sm-8 mb-3">@Model.GroupName</dd>

                    <dt class="col-sm-4 fw-bold mb-3">Children Count</dt>
                    <dd class="col-sm-8 mb-3">@Model.ChildrenCount</dd>

                    <dt class="col-sm-4 fw-bold mb-3">Kindergarten Name</dt>
                    <dd class="col-sm-8 mb-3">@Model.KindergartenName</dd>

                    <dt class="col-sm-4 fw-bold mb-3">Teacher Name</dt>
                    <dd class="col-sm-8 mb-3">@Model.TeacherName</dd>

                    <dt class="col-sm-4 fw-bold mb-3">Created At</dt>
                    <dd class="col-sm-8 mb-3">@Model.CreatedAt.ToString("M/d/yyyy h:mm:ss tt")</dd>

                    <dt class="col-sm-4 fw-bold mb-3">Updated At</dt>
                    <dd class="col-sm-8 mb-3">@Model.UpdatedAt.ToString("M/d/yyyy h:mm:ss tt")</dd>
                </dl>

                <div class="mt-3">
                    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-success">Update</a>
                    <a asp-action="Index" class="btn btn-secondary mx-2">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>
