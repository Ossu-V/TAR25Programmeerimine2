@model IEnumerable<ShopTARpe25.Models.Kindergarten.KindergartenIndexViewModel>


@{
    ViewData["Title"] = "Kindergarten";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <a asp-action="Create" class="btn btn-primary btn-sm my-2">Create</a>
            <h1 class="display-4 fw-bold">Kindergarten</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Nr</th>
                        <th>Group Name</th>
                        <th>Children Count</th>
                        <th>Kindergarten Name</th>
                        <th>Teacher Name</th>
                        <th>Built/Created Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rowNumber = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@rowNumber</td>
                            <td>@item.GroupName</td>
                            <td>@item.ChildrenCount</td>
                            <td>@item.KindergartenName</td>
                            <td>@item.TeacherName</td>
                            <td>@item.CreatedAt.ToString("M/d/yyyy h:mm:ss tt")</td>
                            <td>
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white">Details</a>
                                    <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-success btn-sm">Update</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                                </div>
                            </td>
                        </tr>
                        rowNumber++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
