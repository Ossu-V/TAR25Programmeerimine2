@model ShopTARpe25.Models.Kindergarten.KindergartenUpdateViewModel

@{
    ViewData["Title"] = "Update Kindergarten";
}

<div class="container">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h2 class="my-4 fw-bold">Update Kindergarten</h2>

            <form asp-action="Update" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />

                <div class="form-group mb-3">
                    <label asp-for="GroupName" class="control-label fw-bold">Group Name</label>
                    <input asp-for="GroupName" class="form-control" />
                    <span asp-validation-for="GroupName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ChildrenCount" class="control-label fw-bold">Children Count</label>
                    <input asp-for="ChildrenCount" class="form-control" type="number" />
                    <span asp-validation-for="ChildrenCount" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="KindergartenName" class="control-label fw-bold">Kindergarten Name</label>
                    <input asp-for="KindergartenName" class="form-control" />
                    <span asp-validation-for="KindergartenName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="TeacherName" class="control-label fw-bold">Teacher Name</label>
                    <input asp-for="TeacherName" class="form-control" />
                    <span asp-validation-for="TeacherName" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="control-label fw-bold">Olemasolevad pildid</label>
                    <div class="d-flex flex-wrap gap-3 mt-2">
                        @if (Model.Images != null && Model.Images.Any())
                        {
                            @foreach (var image in Model.Images)
                            {
                                <div class="text-center" style="margin-right: 15px; margin-bottom: 15px; display: inline-block;">
                                    <img src="~/multipleFileUpload/@image.FilePath" style="width: 120px; height: 120px; object-fit: cover; border-radius: 4px; display: block; margin-bottom: 5px;" />
                                    <button type="submit" asp-action="RemoveImage" asp-route-imageId="@image.ImageId" asp-route-kindergartenId="@image.KindergartenId" class="btn btn-danger btn-sm w-100" onclick="return confirm('Kas soovid selle pildi kustutada?');">
                                        Kustuta
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">Pilte pole lisatud.</p>
                        }
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Files" class="control-label fw-bold">Choose Images</label>
                    <input asp-for="Files" type="file" multiple class="form-control" />
                    <span asp-for="Files" class="text-danger"></span>
                </div>

                <div class="form-group my-4">
                    <input type="submit" value="Save Changes" class="btn btn-success" />
                    <a asp-action="Index" class="btn btn-secondary mx-2">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>
