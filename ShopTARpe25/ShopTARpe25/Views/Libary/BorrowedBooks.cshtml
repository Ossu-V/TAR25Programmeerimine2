@model IEnumerable<ShopTARpe25.Models.BookIndexViewModel>

@{
    ViewData["Title"] = "Laenutuses olevad raamatud";
}

<h1>Laenutuses olevad raamatud</h1>

<p>
    <a asp-action="Index" class="btn btn-secondary">Tagasi pealehele</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Pealkiri</th>
            <th>Autor</th>
            <th>Aasta</th>
            <th>Staatus</th>
            <th>Tegevused</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.PublishedYear</td>
                <td>@item.AvailabilityStatus</td>
                <td>
                    <form asp-action="ReturnBook" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-success">Tagasta</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>