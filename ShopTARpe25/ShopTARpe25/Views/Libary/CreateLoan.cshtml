@model IEnumerable<ShopTARpe25.Core.Domain.Reader>

@{
    ViewData["Title"] = "Laenuta raamat";
    var bookTitle = ViewBag.BookTitle as string;
    var bookId = ViewBag.BookId;
}

<h1>Laenuta raamat: @bookTitle</h1>

<form asp-action="CreateLoanConfirmed" method="post">
    <input type="hidden" name="bookId" value="@bookId" />
    
    <div class="form-group mb-3">
        <label class="control-label">Vali lugeja</label>
        <select name="readerId" class="form-control">
            @foreach (var reader in Model)
            {
                <option value="@reader.Id">@reader.FullName (@reader.Email)</option>
            }
        </select>
    </div>

    <div class="form-group mb-3">
        <button type="submit" class="btn btn-success">Kinnita laenutus</button>
        <a asp-action="Index" class="btn btn-secondary">Tagasi</a>
    </div>
</form>