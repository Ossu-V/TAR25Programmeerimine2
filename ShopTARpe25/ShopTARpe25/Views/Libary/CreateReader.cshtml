@{
    ViewData["Title"] = "Lisa uus lugeja";
}

<h1>Lisa uus lugeja</h1>

<form asp-action="CreateReader" method="post">
    <div class="form-group mb-3">
        <label class="control-label">Täisnimi</label>
        <input type="text" name="fullName" class="form-control" required />
    </div>
    <div class="form-group mb-3">
        <label class="control-label">E-post</label>
        <input type="email" name="email" class="form-control" required />
    </div>
    <div class="form-group mb-3">
        <button type="submit" class="btn btn-primary">Salvesta</button>
        <a asp-action="Readers" class="btn btn-secondary">Tagasi</a>
    </div>
</form>