@{
    ViewData["Title"] = "Lisa uus lugeja";
}

<h1>Lisa uus lugeja</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="CreateReader" method="post">
            <div class="form-group mb-3">
                <label class="control-label">Täisnimi</label>
                <input name="fullName" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">E-post</label>
                <input type="email" name="email" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <button type="submit" class="btn btn-primary">Salvesta</button>
                <a asp-action="Index" class="btn btn-primary">Tagasi</a>
            </div>
        </form>
    </div>
</div>
