@model ShopTARpe25.Models.BookDeleteViewModel

@{
    ViewData["Title"] = "Kustuta raamat";
}

<h1>Kustuta raamat</h1>

<h3>Kas oled kindel, et soovid selle raamatu kustutada?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Pealkiri</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        <dt class="col-sm-2">Autor</dt>
        <dd class="col-sm-10">@Model.Author</dd>
        <dt class="col-sm-2">Aasta</dt>
        <dd class="col-sm-10">@Model.PublishedYear</dd>
        <dt class="col-sm-2">Staatus</dt>
        <dd class="col-sm-10">@Model.AvailabilityStatus</dd>
    </dl>
    
    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Kustuta</button>
        <a asp-action="Index" class="btn btn-secondary">Tagasi</a>
    </form>
</div>