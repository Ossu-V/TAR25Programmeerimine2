@model ShopTARpe25.Models.BookDeleteViewModel

@{
    ViewData["Title"] = "Kustuta raamat";
}

<div class="container mt-4">
    <h2>Kustuta raamat</h2>
    <h5 class="text-muted mb-4">Oled kindel, et soovid selle raamatu andmebaasist kustutada?</h5>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2 mb-4">
            @Html.ValidationSummary(false, "", new { @class = "text-danger m-0" })
        </div>
    }

    <div class="card p-4 mb-4" style="max-width: 600px;">
        <dl class="row m-0">
            <dt class="col-sm-4">Pealkiri</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">Autor</dt>
            <dd class="col-sm-8">@Model.Author</dd>

            <dt class="col-sm-4">Ilmumisaasta</dt>
            <dd class="col-sm-8">@Model.PublishedYear</dd>

            <dt class="col-sm-4">Saadavus</dt>
            <dd class="col-sm-8">@Model.AvailabilityStatus</dd>
        </dl>
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger me-2">Kustuta lõplikult</button>
        <a asp-action="Index" class="btn btn-primary">Tühista ja tagasi</a>
    </form>
</div>
