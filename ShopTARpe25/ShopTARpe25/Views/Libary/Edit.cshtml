@model ShopTARpe25.Models.BookEditViewModel

@{
    ViewData["Title"] = "Muuda raamatut";
}

<h1>Muuda raamatu andmeid</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group mb-3">
        <label asp-for="Title" class="control-label">Pealkiri</label>
        <input asp-for="Title" class="form-control" required />
    </div>
    <div class="form-group mb-3">
        <label asp-for="Author" class="control-label">Autor</label>
        <input asp-for="Author" class="form-control" required />
    </div>
    <div class="form-group mb-3">
        <label asp-for="PublishedYear" class="control-label">Ilmumisaasta</label>
        <input asp-for="PublishedYear" type="number" class="form-control" required />
    </div>
    <div class="form-group mb-3">
        <button type="submit" class="btn btn-primary">Salvesta</button>
        <a asp-action="Index" class="btn btn-secondary">Tagasi</a>
    </div>
</form>