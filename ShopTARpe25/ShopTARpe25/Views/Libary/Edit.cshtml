@model ShopTARpe25.Models.BookEditViewModel

@{
    ViewData["Title"] = "Muuda raamatut";
}

<h1>Muuda raamatut</h1>

<div class="row mt-4">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label class="control-label">Pealkiri</label>
                <input asp-for="Title" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Autor</label>
                <input asp-for="Author" class="form-control" readonly />
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Ilmumisaasta</label>
                <input asp-for="PublishedYear" class="form-control" readonly />
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-warning">Salvesta muudatused</button>
                <a asp-action="Index" class="btn btn-primary">Tühista</a>
            </div>
        </form>
    </div>
</div>
