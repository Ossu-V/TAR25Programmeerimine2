@model IEnumerable<ShopTARpe25.Models.BookIndexViewModel>

@{
    ViewData["Title"] = "Raamatud";
}

<h1>Raamatute nimekiri</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Lisa uus raamat</a>
    <a asp-action="BorrowedBooks" class="btn btn-primary">Laenutuses olevad raamatud</a>
    <a asp-action="Readers" class="btn btn-primary">Lugejad</a>
</p>

<form method="get" class="mb-3">
    <div class="row">
        <div class="col-md-4">
            <input type="text" name="searchTitle" class="form-control" placeholder="Otsi pealkirja järgi..." />
        </div>
        <div class="col-md-3">
            <input type="number" name="searchYear" class="form-control" placeholder="Otsi aasta järgi..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary">Otsi</button>
        </div>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Pealkiri</th>
            <th>Autor</th>
            <th>Aasta</th>
            <th>Staatus</th>
            <th>Tegevused</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.PublishedYear</td>
                <td>@item.AvailabilityStatus</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" style="background-color: orange; border-color: orange; color: white;">Muuda</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Kustuta</a>
                    @if (item.AvailabilityStatus == "Saadaval")
                    {
                        <a asp-action="CreateLoan" asp-route-id="@item.Id" class="btn btn-sm btn-success">Laenuta</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>