@model ShopTARpe25.Models.ReaderLoansViewModel

@{
    ViewData["Title"] = "Lugeja laenutused";
}

<h1>Lugeja: @Model.ReaderName laenutused</h1>

<p>
    <a asp-action="Readers" class="btn btn-secondary">Tagasi lugejate juurde</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Raamat</th>
            <th>Laenutamise kuupäev</th>
            <th>Tagastamise kuupäev</th>
            <th>Staatus</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Loans)
        {
            <tr>
                <td>@item.BookTitle</td>
                <td>@item.LoanDate.ToShortDateString()</td>
                <td>@(item.ReturnDate.HasValue? item.ReturnDate.Value.ToShortDateString() : "-")</td>
                <td>@item.Status</td>
            </tr>
        }
    </tbody>
</table>