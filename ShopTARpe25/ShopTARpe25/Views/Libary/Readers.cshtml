@model IEnumerable<ShopTARpe25.Models.ReaderIndexViewModel>

@{
    ViewData["Title"] = "Lugejad";
}

<h1>Lugejate nimekiri</h1>

<p>
    <a asp-action="CreateReader" class="btn btn-primary">Lisa uus lugeja</a>
    <a asp-action="Index" class="btn btn-secondary">Tagasi raamatute juurde</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nimi</th>
            <th>E-post</th>
            <th>Tegevused</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>
                    <a asp-action="ReaderLoans" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Vaata laenutusi</a>
                </td>
            </tr>
        }
    </tbody>
</table>