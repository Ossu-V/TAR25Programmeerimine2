@model ShopTARpe25.Models.Spaceship.SpaceshipCreateViewModel

@{
    ViewData["Title"] = "Create";
}
<h1>@ViewData["Title"]</h1>

<form asp-action="Create" asp-controller="Spaceship" method="post" enctype="multipart/form-data">
    
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="ModifiedAt" type="hidden" />

    <div>
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control" />
        </div>
    </div>
    <div>
        <label asp-for="Classification" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Classification" class="form-control" />
        </div>
    </div>
    <div>
        <label asp-for="BuiltDate" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="BuiltDate" class="form-control" />
        </div>
    </div>
    <div>
        <label asp-for="Crew" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Crew" class="form-control" />
        </div>
    </div>
    <div>
        <label asp-for="EnginePower" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="EnginePower" class="form-control" />
        </div>
    </div>

    <div class="form-group mt-3">
        <input type="submit" class="btn btn-success" value="Create" />
        <a asp-action="Index" asp-controller="Spaceship" class="btn btn-success">Back to list</a>
    </div>

</form>