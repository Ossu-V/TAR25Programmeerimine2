@model ShopTARpe25.Models.Spaceship.ImageViewModel

@{
    var photoPaths = "~/multipleFileUpload/" + (Model.FilePath ?? "noimage.jpg");
}

<div class="form-group row col-sm-4-offset-2">
    <div>@Model.FilePath</div>
    <img class="card-image-top" src="@photoPaths" asp-append-version="true" style="max-width: 350px; height: auto; display: block; margin-top: 5px;" />
</div>
